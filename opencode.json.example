{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["better-opencode"],
  "plugins": {
    "selfImproving": {
      "enabled": true,
      "confidenceThreshold": 3,
      "maxSkillsPerSession": 5,
      "maxInstincts": 200,
      "ttlDays": 14,
      "vectorStore": "memory",
      "embeddingModel": "potion-code-16M",
      "ragTokenBudget": 4000,
      "systemBudget": 2200,
      "adaptiveCompute": "auto"
    }
  }
}
